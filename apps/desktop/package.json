{
  "name": "gnirehtet-gui-desktop",
  "version": "0.1.0",
  "description": "Desktop app for gnirehtet reverse tethering (Tauri 2 + SvelteKit)",
  "type": "module",
  "scripts": {
    "setup": "node ../../scripts/fetch-upstream.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
