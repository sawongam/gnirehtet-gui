{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gnirehtet-gui",
  "version": "0.1.0",
  "identifier": "com.gnirehtet.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "gnirehtet-gui",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../../resources/*"
    ],
    "externalBin": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
