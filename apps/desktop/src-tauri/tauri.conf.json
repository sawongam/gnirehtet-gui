{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gnirehtet-gui",
  "mainBinaryName": "gnirehtet-gui",
  "version": "0.1.0",
  "identifier": "io.github.sawongam.gnirehtet-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gnirehtet",
        "width": 760,
        "height": 720,
        "minWidth": 560,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Reverse tethering for Android over USB",
    "longDescription": "Share your computer's internet connection with an Android device over USB, without root. A desktop front-end for Genymobile's gnirehtet.",
    "copyright": "Copyright (c) Sangam Adhikari and contributors. gnirehtet (c) Genymobile.",
    "publisher": "Sangam Adhikari",
    "homepage": "https://github.com/sawongam/gnirehtet-gui",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../resources/gnirehtet.apk": "gnirehtet.apk"
    },
    "externalBin": [
      "binaries/gnirehtet-relay"
    ],
    "linux": {
      "deb": {
        "recommends": [
          "adb"
        ],
        "desktopTemplate": "linux/gnirehtet-gui.desktop"
      },
      "rpm": {
        "recommends": [
          "android-tools"
        ],
        "desktopTemplate": "linux/gnirehtet-gui.desktop"
      }
    },
    "windows": {
      "digestAlgorithm": "sha256"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
